# The ID of your GitHub App
APP_ID=

# Organization considered "internal"; PR authors not in this org get the community label (default: RocketChat)
# INTERNAL_ORG=RocketChat

# Extra comma-separated logins never labeled community (bots already excluded via [bot] suffix)
# COMMUNITY_LABEL_EXCLUDED_EXTRA=some-user,another-user
WEBHOOK_SECRET=development

# info (default): one line per webhook plus actions taken and errors. debug: also inputs and API responses
LOG_LEVEL=debug

# json (default in production) or pretty (default elsewhere)
# LOG_FORMAT=pretty

# Go to https://smee.io/new set this to the URL that you are redirected to.
WEBHOOK_PROXY_URL=

# Allows an immediate squash merge on branches with no merge queue and no auto-merge.
# It is the only strategy that does not wait for anything, so it is off unless set to "true",
# and even then it only runs when mergeable_state is "clean".
# ALLOW_DIRECT_SQUASH_MERGE=false

JIRA_BASE_URL=
JIRA_API_TOKEN=
